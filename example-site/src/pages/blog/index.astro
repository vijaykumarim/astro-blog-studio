---
import { getCollection } from 'astro:content';
import { categoriesFor } from '../../lib/categories';
const posts = (await getCollection('posts')).sort((a, b) =>
  b.data.created_at.localeCompare(a.data.created_at),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>The Journal · Blog Studio example</title>
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="The Journal" />
  </head>
  <body>
    <header>
      <a href="/blog/">The Journal.</a>
      <span>Powered by Astro + Blog Studio</span>
    </header>
    <main>
      <p class="eyebrow">IDEAS. STORIES. PERSPECTIVES.</p>
      <h1>
        Something worth
        <br />
        <em>spending time with.</em>
      </h1>
      <p class="intro">A collection of stories, fresh ideas and useful guides.</p>
      <nav aria-label="Categories">
        {[
          ...new Map(posts.flatMap((p) => categoriesFor(p.data)).map((c) => [c.slug, c])).values(),
        ].map((c) => (
          <a
            style="display:inline-block;margin:0 20px 24px 0"
            href={'/blog/category/' + c.slug + '/'}
          >
            {c.name}
          </a>
        ))}
      </nav>
      <div class="grid">
        {posts.map(({ data }) => (
          <article>
            <a href={'/blog/' + data.slug + '/'}>
              <img src={'/media/' + data.image} alt={data.alt} />
              <div>
                <small>{data.category}</small>
                <h2>{data.title}</h2>
                <p>{data.excerpt}</p>
                <span>Read the story ↗</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      {posts.length === 0 && <p class="empty">The first story is on its way.</p>}
    </main>
    <footer>A local example website. Your public website keeps its own design.</footer>
  </body>
</html>
<style>
  body {
    margin: 0;
    background: #fafbf7;
    color: #24372d;
    font-family: system-ui;
  }
  * {
    box-sizing: border-box;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  header {
    max-width: 1100px;
    margin: auto;
    padding: 28px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #dfe5da;
  }
  header a {
    font: 30px Georgia;
  }
  header span {
    font-size: 11px;
    color: #657166;
  }
  main {
    max-width: 1100px;
    margin: auto;
    padding: 65px 24px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    color: #437b5c;
  }
  h1 {
    font: clamp(38px, 5vw, 64px)/1.1 Georgia;
    letter-spacing: -1.5px;
    margin: 22px 0;
  }
  h1 em {
    color: #43835b;
  }
  .intro {
    color: #657166;
    margin-bottom: 48px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }
  article {
    background: white;
    border: 1px solid #e0e6dc;
    border-radius: 14px;
    overflow: hidden;
  }
  article img {
    width: 100%;
    aspect-ratio: 1.5;
    object-fit: cover;
  }
  article div {
    padding: 24px;
  }
  article small {
    font-size: 10px;
    color: #43835b;
    text-transform: uppercase;
    letter-spacing: 1.3px;
  }
  article h2 {
    font: 25px/1.25 Georgia;
  }
  article p {
    font-size: 14px;
    line-height: 1.7;
    color: #657166;
  }
  article span {
    font-size: 12px;
    color: #43835b;
  }
  .empty {
    padding: 50px;
    border: 1px dashed #b6c7b5;
    border-radius: 14px;
  }
  footer {
    text-align: center;
    padding: 30px;
    font-size: 12px;
    color: #657166;
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
    header span {
      display: none;
    }
    main {
      padding-top: 40px;
    }
  }
</style>
