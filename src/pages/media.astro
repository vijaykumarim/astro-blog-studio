---
import Dashboard from '../layouts/Dashboard.astro';
import { db } from '../lib/db.mjs';
import sharp from 'sharp';
import { stat, readFile } from 'node:fs/promises';
import { dataDir, inside } from '../lib/config.mjs';
import path from 'node:path';
import type { Media } from '../lib/types';
const items = db
  .prepare('SELECT * FROM media ORDER BY created_at DESC')
  .all() as unknown as Media[];
const details = new Map();
for (const item of items) {
  try {
    const file=inside(path.join(dataDir,'media'),item.filename);
    const info=await sharp(await readFile(file)).metadata();
    const size=(await stat(file)).size;
    details.set(item.id,{width:info.width,height:info.height,bytes:size,size:size<1024?`${size} B`:size<1048576?`${(size/1024).toFixed(1)} KB`:`${(size/1048576).toFixed(2)} MB`});
  } catch { details.set(item.id,{size:'Unavailable'}); }
}
---

<Dashboard title="Media library" active="media">
  <div class="page-heading">
    <div>
      <p class="eyebrow">A PICTURE TELLS A STORY</p>
      <h1>Your image library.</h1>
      <p>Images uploaded in the editor are available here.</p>
    </div>
  </div>
  {items.length ? (
    <div class="media-grid">
      {items.map((item) => (
        <figure class="panel">
          <button class="media-open" type="button" aria-label={'View image details: '+item.filename} data-media-details={JSON.stringify({...item,...details.get(item.id),url:new URL('/media/'+item.filename,Astro.url.origin).href})}>
          <img
            src={'/media/' + item.filename}
            alt={item.alt || 'Uploaded article image'}
            loading="lazy"
            width="300"
            height="200"
          />
          </button>
          <figcaption>
            {new Date(item.created_at).toLocaleDateString()}
            <small>{item.filename.split('.').at(-1)?.toUpperCase()} · {details.get(item.id).size}</small>
            {details.get(item.id).width && <small>{details.get(item.id).width} × {details.get(item.id).height} px</small>}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div class="panel empty">
      <div class="empty-art">▧</div>
      <h2>Make room for good imagery.</h2>
      <p>Upload a featured image or insert an image in your next post.</p>
      <a class="button" href="/posts/new">
        Create a post ↗
      </a>
    </div>
  )}
  <dialog id="media-details" class="media-drawer" aria-labelledby="media-details-title">
    <header><h2 id="media-details-title">Image details</h2><button class="button" type="button" data-media-close aria-label="Close image details">✕</button></header>
    <img class="media-detail-preview" alt="" />
    <dl><dt>Filename</dt><dd data-detail="filename"></dd><dt>Dimensions</dt><dd data-detail="dimensions"></dd><dt>File size</dt><dd data-detail="size"></dd><dt>Format</dt><dd data-detail="format"></dd><dt>Uploaded</dt><dd data-detail="date"></dd><dt>Image description</dt><dd data-detail="alt"></dd></dl>
    <label for="media-url">Image URL</label><input id="media-url" readonly />
    <div class="actions"><button type="button" class="button primary" data-media-copy>Copy URL</button><a class="button" data-media-view target="_blank" rel="noopener">Open image ↗</a></div>
    <p class="media-url-note">This dashboard URL requires sign-in. Published posts serve their own copy on your website.</p>
    <p data-media-status role="status"></p>
    <button type="button" class="button" data-media-delete>Delete image</button>
    <p class="media-url-note">Images used in drafts or published posts cannot be deleted.</p>
  </dialog>
  <script>import '../scripts/media';</script>
</Dashboard>
