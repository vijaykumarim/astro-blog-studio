---
import '../styles/studio.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Set your password · Blog Studio</title>
  </head>
  <body class="auth-page">
    <main class="auth-card">
      <div class="brand">
        <span class="brand-icon">b.</span> Blog Studio
      </div>
      <p class="eyebrow">YOUR WORKSPACE</p>
      <h1>
        Make yourself
        <br />
        at home.
      </h1>
      <p>Choose a password with at least 12 characters.</p>
      <form id="set-password-form">
        <label class="field">
          New password
          <input
            type="password"
            name="password"
            minlength="12"
            maxlength="128"
            autocomplete="new-password"
            required
          />
        </label>
        <label class="field">
          Confirm password
          <input
            type="password"
            name="confirm"
            minlength="12"
            maxlength="128"
            autocomplete="new-password"
            required
          />
        </label>
        <button class="button primary">Set password →</button>
        <p role="alert" id="auth-status"></p>
      </form>
      <a class="back" href="/login">
        Back to sign in
      </a>
    </main>
    <script src="../scripts/auth.ts"></script>
  </body>
</html>
