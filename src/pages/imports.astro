---
import Dashboard from '../layouts/Dashboard.astro';
if (Astro.locals.account?.role !== 'admin') return Astro.redirect('/');
---

<Dashboard title="Import posts" active="imports">
  <div class="page-heading">
    <div>
      <p class="eyebrow">MOVE YOUR BLOG</p>
      <h1>Import posts</h1>
      <p>Bring WordPress XML or JSON posts into ABS as drafts.</p>
    </div>
  </div>
  <section class="panel migration-panel">
    <h2>1. Choose your export</h2>
    <p>
      For WordPress posts, install
      <a href="https://wordpress.org/plugins/export-media-with-selected-content/" target="_blank" rel="noopener noreferrer">Export media with selected content</a>
      and enable its checkbox under Tools → Export. This includes the image references ABS needs to download featured and inline images.
    </p>
    <p>
      Up to 100 MB per file, with no fixed total post count. Posts are processed sequentially in batches of up to 250 (smaller for large articles). Keep this tab open until finished. WordPress pages, private and trashed posts are
      excluded. Existing posts are never overwritten.
    </p>
    <label>
      Export file
      <input id="import-file" type="file" accept=".xml,.json" />
    </label>
    <a href="/import-example.json" download>
      Download an example JSON file
    </a>
    <h2>2. Add images (optional)</h2>
    <p>
      Download images referenced by WordPress XML, including exports from Export media with selected content. Keep the original site online. Images download one at a time and use your image settings. Failed images are listed for review. You can also supply a media folder.
    </p>
    <label class="migration-check"><input id="import-download" type="checkbox" checked /> Download images from the original website</label>
    <label>
      Media folder
      <input id="import-media" type="file" {...{ webkitdirectory: '' }} multiple />
    </label>
    <label class="migration-check">
      <input id="import-redirects" type="checkbox" checked /> Create 301 redirect mappings from old
      post URLs
    </label>
    <button class="button primary" id="import-preview">
      Preview import
    </button>
    <p id="import-progress" role="status"></p>
    <p id="migration-error" role="alert" hidden></p>
  </section>
  <section class="panel migration-panel" id="import-review" hidden>
    <h2>3. Review and import</h2>
    <p>
      Only ready rows are imported. Missing images and unsupported formatting need review before you
      publish. Imported redirect mappings are withheld from server exports until their posts are
      published.
    </p>
    <div id="import-rows" class="migration-rows"></div>
    <button class="button primary" id="import-run">
      Import ready posts as drafts
    </button>
  </section>
  <script>
    import '../scripts/imports';
  </script>
</Dashboard>
